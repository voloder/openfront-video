# openfront.video settings for docker compose. Copy to .env and fill in the
# first section; everything below it has working defaults.

# ── Required ──

# The domain the site is served on. DNS A/AAAA records for it and for www.
# must point at this server, with ports 80 and 443 open.
DOMAIN=openfront.video
# Let's Encrypt account email (certificate expiry notices).
ACME_EMAIL=you@example.com

# ── Rendering ──

# Games rendered at the same time; each uses several CPU cores. A person's
# request takes a slot from an automatic render when all are busy.
MAX_RENDERS=2
# Seconds a link previewer (Discordbot etc.) is held while its game renders,
# so the embed can include the video.
EMBED_WAIT_SECS=25
# Seconds a request for /video/<id>.mp4 waits for a render in progress.
VIDEO_WAIT_SECS=120
# Most disk space the videos may use, in GB (0 = no limit). Over it, the least
# recently viewed games are deleted until usage is under 90% of it; a deleted
# game is rendered again when someone asks. A video is about 22 MB, so 35 GB
# keeps roughly 1,500, with headroom on a 40 GB volume.
MAX_STORAGE_GB=35
# Games from engine versions the Rust renderer doesn't follow (older ones, or a
# new release it hasn't been updated for) render with OpenFront's own
# TypeScript engine at that exact version. The server checks each version out
# into /data/engines the first time a game needs it (about 2 minutes and 1 GB)
# and keeps this many, the most recently used. They don't count toward
# MAX_STORAGE_GB.
ENGINES_KEEP=3

# ── Automatic rendering of finished public games ──

# 1 = on, 0 = off (videos are then only made when someone asks).
AUTO_RENDER=1
# How often to check OpenFront for newly finished games, in seconds.
AUTO_POLL_SECS=60
# How far back to look at game start times (games run up to about 3 hours).
AUTO_LOOKBACK_MINS=180
# Skip games that ended longer ago than this; ~10 public games end every
# minute, more than a server renders, so the newest ones win.
AUTO_MAX_AGE_MINS=30
# Only games with at least this many players.
AUTO_MIN_PLAYERS=10

# ── Admin dashboard & Bot API (optional) ──

# Password for https://<DOMAIN>/admin (browser login prompt, any user name).
# Empty = the dashboard is off (404). Use a long random one.
ADMIN_PASSWORD=

# Bearer token for POST https://<DOMAIN>/api/v1/render, so external bots can
# request or pre-warm renders on demand. Empty = the endpoint is off (404).
RENDER_API_TOKEN=

# ── Ads (optional) ──

# Google AdSense publisher ID (ca-pub-...); empty = no ads. Ads only show on
# the home page and finished video pages, and /ads.txt is served for it.
ADSENSE_CLIENT=
# An ad unit ID for a fixed responsive unit under the video (on top of Auto ads).
ADSENSE_SLOT=
